rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Company profile
    match /companies/{document=**} {
      allow read, write: if true;
    }

    // Partners & equity records
    match /partners/{document=**} {
      allow read, write: if true;
    }

    // Staffs directory & profiles
    match /staffs/{document=**} {
      allow read, write: if true;
    }

    // Accounts & Transactions ledger
    match /accounts/{document=**} {
      allow read, write: if true;
    }

    match /transactions/{document=**} {
      allow read, write: if true;
    }

    // Customer dues & receivables
    match /customerDues/{document=**} {
      allow read, write: if true;
    }

    // Application settings, admin auth & notices
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // Test connection collection
    match /test/{document=**} {
      allow read, write: if true;
    }
  }
}
